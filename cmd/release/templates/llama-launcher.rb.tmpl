# Generated by cmd/release in airiclenz/llama-launcher and overwritten at each release: edit
# cmd/release/templates/llama-launcher.rb.tmpl there, never this file.
class LlamaLauncher < Formula
  desc "CLI tool for managing local LLM servers (llama.cpp, Ollama, LM Studio, Splash)"
  homepage "https://github.com/airiclenz/llama-launcher"
  version "{{.Version}}"
  license "MIT"

  # Installs the prebuilt binaries for this platform rather than compiling, so no Go
  # toolchain is needed. The tree is CGO-free, so all four release targets come off
  # one `cmd/release dist` in the project repo.
  on_macos do
    on_arm do
{{- with .Archive "darwin" "arm64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
    on_intel do
{{- with .Archive "darwin" "amd64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
  end

  on_linux do
    on_arm do
{{- with .Archive "linux" "arm64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
    on_intel do
{{- with .Archive "linux" "amd64"}}
      url "{{.URL}}"
      sha256 "{{.SHA256}}"
{{- end}}
    end
  end

  def install
    bin.install "llama-launcher", "llama-launcher-mcp"
  end

  test do
    # `llama-launcher version` and `llama-launcher-mcp --version` each print the bare X.Y.Z.
    assert_match version.to_s, shell_output("#{bin}/llama-launcher version")
    assert_match version.to_s, shell_output("#{bin}/llama-launcher-mcp --version")
  end
end
