{
    "##": "Generated by cmd/release in airiclenz/llama-launcher and overwritten at each release: edit cmd/release/templates/scoop.json.tmpl there, never this file.",
    "version": "{{.Version}}",
    "description": "CLI tool for managing local LLM servers (llama.cpp, Ollama, LM Studio, Splash)",
    "homepage": "https://github.com/airiclenz/llama-launcher",
    "license": "MIT",
    "architecture": {
{{- with .Archive "windows" "amd64"}}
        "64bit": {
            "url": "{{.URL}}",
            "hash": "{{.SHA256}}",
            "extract_dir": "{{.Stem}}"
        },
{{- end}}
{{- with .Archive "windows" "arm64"}}
        "arm64": {
            "url": "{{.URL}}",
            "hash": "{{.SHA256}}",
            "extract_dir": "{{.Stem}}"
        }
{{- end}}
    },
    "bin": "llama-launcher.exe",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/airiclenz/llama-launcher/releases/download/v$version/llama-launcher_$version_windows_amd64.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS"
                },
                "extract_dir": "llama-launcher_$version_windows_amd64"
            },
            "arm64": {
                "url": "https://github.com/airiclenz/llama-launcher/releases/download/v$version/llama-launcher_$version_windows_arm64.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS"
                },
                "extract_dir": "llama-launcher_$version_windows_arm64"
            }
        }
    }
}
